# Copy to .env and replace every secret before running docker compose.

# MongoDB credentials (URL-encode special characters if you change them)
MONGO_ROOT_USER=amigo
MONGO_ROOT_PASSWORD=change-me-to-a-strong-password
MONGO_PORT=27017

# JWT signing key: generate with `openssl rand -hex 32` (at least 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Public URL browsers use to reach the app (used for CORS)
PUBLIC_ORIGIN=http://localhost:8080

# Host ports
CLIENT_PORT=8080
SERVER_PORT=5000
ANALYTICS_PORT=8000
RATE_LIMIT_MAX=300
