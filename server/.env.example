NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/amigo
MONGO_CONNECT_TIMEOUT_MS=3000
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173,http://localhost:4173
ANALYTICS_SERVICE_URL=http://localhost:8000
ANALYTICS_TIMEOUT_MS=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Seed a rich demo catalog, customers, and 28 days of orders when the DB is empty.
# Defaults to true outside production; set false to start with an empty database.
SEED_DEMO_DATA=true
